{
  "name": "build-with-ai",
  "version": "1.2.0",
  "description": "A minimal, zero-API CLI that guides developers through building software with any AI by giving them the right prompt at each step.",
  "bin": {
    "build-with-ai": "bin/cli.js"
  },
  "main": "bin/cli.js",
  "files": [
    "bin",
    "lib",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node tests/test-flow.js",
    "test:e2e": "node tests/e2e-test.js",
    "test:all": "node tests/test-flow.js && node tests/e2e-test.js",
    "lint": "eslint \"{bin,lib,tests}/**/*.js\"",
    "lint:fix": "eslint \"{bin,lib,tests}/**/*.js\" --fix",
    "format": "prettier --write \"{bin,lib,tests}/**/*.js\"",
    "format:check": "prettier --check \"{bin,lib,tests}/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PicadoLabs/build-with-ai.git"
  },
  "bugs": {
    "url": "https://github.com/PicadoLabs/build-with-ai/issues"
  },
  "homepage": "https://github.com/PicadoLabs/build-with-ai#readme",
  "keywords": [
    "ai",
    "cli",
    "prompt-engineering",
    "developer-tools",
    "workflow",
    "scaffolding",
    "guide",
    "rag",
    "saas",
    "react-native",
    "chrome-extension",
    "ai-agent",
    "copilot",
    "zero-api"
  ],
  "author": "PicadoLabs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "clipboardy": "^3.0.0",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9"
  }
}
